{
  "name": "printpulse-kiosk-app",
  "version": "1.0.0",
  "description": "Standalone Commercial Self-Service Xerox & Printing Kiosk Desktop Application",
  "main": "electron/main.js",
  "author": "PrintPulse Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev:backend": "cd backend && npm start",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:print": "cd print-service && node src/index.js",
    "build:frontend": "cd frontend && npm run build",
    "electron:dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:print\" \"wait-on http://localhost:8501 && electron .\"",
    "build:exe": "npm run build:frontend && electron-builder --win"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdf-to-printer": "^5.6.0",
    "pg": "^8.11.5",
    "qrcode": "^1.5.3",
    "razorpay": "^2.9.3",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "wait-on": "^7.2.0"
  }
}
